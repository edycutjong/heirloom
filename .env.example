# Heirloom — environment for the LIVE scripts only. Tests (forge, vitest, Playwright) need none of this.
# Copy to .env (gitignored) or keep real keys in ~/.config/reactive/*.env, which the shell scripts source by default.
# Never commit a filled-in copy.

# ── RPC endpoints (optional: every chain falls back to the public default in packages/reactive-kit/ts/chains.ts) ──
# Get from: https://dev.reactive.network/ → Reactive Lasna testnet RPC (default https://lasna-rpc.rnk.dev/)
LASNA_RPC=
# Get from: https://dev.reactive.network/ → Reactive mainnet RPC (default https://mainnet-rpc.rnk.dev/)
REACTIVE_RPC=
# Get from: https://docs.base.org/chain/network-information (default https://sepolia.base.org) or any Base Sepolia provider
BASE_SEPOLIA_RPC=
# Get from: https://docs.base.org/chain/network-information or any Base mainnet provider (default https://base-rpc.publicnode.com)
BASE_RPC=
# Get from: https://ethereum-sepolia-rpc.publicnode.com (default) or any Ethereum Sepolia provider
ETHEREUM_SEPOLIA_RPC=
# Get from: https://docs.unichain.org/docs/technical-information/network-information (default https://sepolia.unichain.org)
UNICHAIN_SEPOLIA_RPC=

# ── scripts/trigger-spoof.ts (fire a stranger's $0 transfer at the live long-T instance) ──
# Get from: any Base Sepolia wallet that is NOT the instance owner, funded from a faucet (https://console.optimism.io/faucet)
PRIVATE_KEY=

# ── Deploy scripts (script/heirloom-deploy.sh, scripts/deploy-mainnet.sh) ──
# Get from: your own deployer wallet. The scripts read these from $HEIRLOOM_ENV / $DEPLOY_ENV
# (default ~/.config/reactive/testnet-deployer.env or mainnet-deployer.env), not from this file.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Get from: the address that should receive the estate (required by scripts/deploy-mainnet.sh)
HEIR=
# Get from: your everyday wallet if it should own the instance (optional; defaults to the deployer)
OWNER=
